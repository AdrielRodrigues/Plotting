    "        plt.xlabel('Load (erlangs)', fontsize=16)\n",
    "\n",
    "        # Customize X-axis to show the point clearly\n",
    "        plt.xticks(x)\n",
    "\n",
    "        # Show plot\n",
    "        plt.grid(True)\n",
    "        plt.savefig(f'./figures/{metric}-{topology}.png', dpi=300, bbox_inches='tight')\n",
